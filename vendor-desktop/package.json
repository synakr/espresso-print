{
  "name": "@qr-print/vendor-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.akhram.qrprintbridge",
    "productName": "QR Print Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "electron/*.html",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__,coverage,.cache,.vite}/**",
      "!**/*.{md,markdown,ts,tsx}"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
